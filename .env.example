# X/Twitter API credentials
X_BEARER_TOKEN=your_bearer_token
X_API_KEY=your_api_key
X_API_SECRET=your_api_secret
X_ACCESS_TOKEN=your_access_token
X_ACCESS_SECRET=your_access_secret

# AI provider: "ollama" (local), "anthropic" (Claude), "openai" (OpenAI + compatible APIs)
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434
AI_MODEL=qwen3.5:9b
AI_TIMEOUT_SECONDS=300
# AI_API_KEY=your_api_key  # required for anthropic and openai providers

# OpenAI-compatible examples (set AI_PROVIDER=openai for all of these):
# OpenAI:      AI_BASE_URL=https://api.openai.com       AI_MODEL=gpt-4o-mini
# Groq:        AI_BASE_URL=https://api.groq.com/openai   AI_MODEL=llama-3.3-70b-versatile
# Together:    AI_BASE_URL=https://api.together.xyz       AI_MODEL=meta-llama/Llama-3-70b-chat-hf
# LM Studio:   AI_BASE_URL=http://localhost:1234          AI_MODEL=local-model
# DeepSeek:    AI_BASE_URL=https://api.deepseek.com       AI_MODEL=deepseek-chat

# Bot configuration
BOT_NICHE=AI tools and productivity
BOT_LANGUAGE=en
BOT_SEARCH_LANGUAGES=en,ja,de
BOT_MAX_RESULTS_PER_SEARCH=10
BOT_EXPAND_AUTHORS=false
BOT_POST_MAX_LENGTH=280
BOT_POST_VARIANTS=quick-insight,deep-insight
BOT_DELAY_BETWEEN_POSTS_SECONDS=180
BOT_POSTS_PER_DAY=8
BOT_MIN_INTERVAL_MINUTES=45
BOT_MAX_INTERVAL_MINUTES=180
BOT_PEAK_HOURS=9,12,15,18,20
BOT_REPLY_ENABLED=false
BOT_REPLY_CHANCE_PERCENT=3

# Debug mode: prints prompts, AI responses, API calls, timing stats
# DEBUG=true

# Log file: write all output (log + debug) to a file. Leave empty to disable.
# LOG_FILE=xbot.log
