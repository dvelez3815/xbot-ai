{
  "name": "xbot-ai",
  "version": "0.1.0",
  "description": "AI-powered X/Twitter automation bot — trend-aware, niche-focused, human-like posting",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "xbot": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test test/*.test.ts"
  },
  "keywords": ["twitter", "x", "bot", "ai", "automation", "trends"],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "twitter-api-v2": "^1.19.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.39.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
